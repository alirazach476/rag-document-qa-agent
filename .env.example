# Chat provider: ollama (free) or openai (paid)
LLM_PROVIDER=ollama

# Embeddings: auto | local (GPU/CPU sentence-transformers) | ollama | openai
# "local" on NVIDIA CUDA is much faster for PDF rebuilds than Ollama embeddings.
EMBEDDING_BACKEND=local
EMBEDDING_DEVICE=cuda
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# --- Ollama chat (free) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- OpenAI (optional) ---
# LLM_PROVIDER=openai
# EMBEDDING_BACKEND=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=1200
CHUNK_OVERLAP=100
TOP_K=4
TEMPERATURE=0.1
